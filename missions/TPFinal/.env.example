# Copiar a .env (gitignoreado) y completar. Nunca commitear valores reales.
# En Modal, HF_TOKEN, WANDB_API_KEY y HF_REPO viven en el secret "tp-secrets"
# (ver modal_entrenamiento.md y MODAL.md).

# Token de Hugging Face con permiso de escritura sobre HF_REPO (y de lectura de
# google/gemma-4-E4B-it y del adaptador). La cátedra pone el suyo, de solo lectura.
HF_TOKEN=

# Clave de Weights & Biases para registrar las corridas de entrenamiento.
WANDB_API_KEY=

# Repo privado de modelo en Hugging Face donde se suben los adaptadores,
# con la forma <usuario u organización>/<nombre>.
HF_REPO=

# Opcional: otro archivo de configuracion en lugar de config.yaml (por ejemplo config_optimizado.yaml).
# CONFIG=
